# Copy to .env and fill in. Everything optional: unset values use offline mocks.
# TigerGraph Savanna (live graph). Leave hosts empty for local mock fallback.
TIGERGRAPH_HOST=
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_GRAPH=FraudGraph
# Legacy aliases honoured by the mock client (prefer TIGERGRAPH_* above).
TG_HOST=
TG_USERNAME=
TG_PASSWORD=
TG_CLIENT_SECRET=
# Model + MCP server (mock-heuristic path needs neither).
LLM_MODEL=mock-heuristic
MODEL_API_KEY=
MCP_SERVER_URL=http://localhost:8000/mcp
