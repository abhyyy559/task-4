-- =====================================================================
-- queries.gsql — 8 named FraudGraph queries (TigerGraph Savanna / GSQL)
-- Part 1 (S2.1.2): q_card_ring, q_device_cluster, q_mule_fanout
-- Part 2 (S2.1.3): q_takeover_anomaly, q_synthetic_identity, q_evidence_subgraph
-- Part 3: q_get_transactions, q_ring_components (WCC label propagation)
-- Every query returns evidence IDs (TransactionID txn_id values / node IDs).
-- Graph: fraud_graph (see schema.gsql).
-- =====================================================================
USE GRAPH fraud_graph

-- Q1: q_card_ring — card-not-present ring expansion.
-- Params: card_id (CARD.card_id), start_dt/end_dt (TRANSACTION.dt window).
-- Returns: Ring (TRANSACTION vertices: evidence txn_ids), plus linked
--   Emails and Devices for pivot. Covers card_not_present_fraud investigations (shared-card ring pivot).
CREATE QUERY q_card_ring(STRING card_id, UINT start_dt, UINT end_dt) FOR GRAPH fraud_graph {
  Seed = {CARD.*};
  Seed = SELECT s FROM Seed:s WHERE s.card_id == card_id;
  Ring = SELECT t FROM Seed:s -(MADE_WITH)- TRANSACTION:t
         WHERE t.dt BETWEEN start_dt AND end_dt;
  Emails = SELECT e FROM Ring:t -(USED_EMAIL)- EMAIL:e;
  Devices = SELECT d FROM Ring:t -(USED_DEVICE)- DEVICE:d;
  PRINT Ring, Emails, Devices;
}

-- Q2: q_device_cluster — device-spoofing cluster expansion.
-- Params: device (DEVICE.device fingerprint), min_cards (cluster threshold).
-- Returns: Txns (TRANSACTION evidence IDs), Cards (CARD node IDs funnelled
--   through the device). Supports card_not_present_new_device / undocumented investigations (device-cluster pivot).
CREATE QUERY q_device_cluster(STRING device, UINT min_cards) FOR GRAPH fraud_graph {
  Seed = {DEVICE.*};
  Seed = SELECT s FROM Seed:s WHERE s.device == device;
  Txns = SELECT t FROM Seed:s -(USED_DEVICE)- TRANSACTION:t;
  Cards = SELECT c FROM Txns:t -(MADE_WITH)- CARD:c;
  PRINT Txns, Cards;
}

-- Q3: q_mule_fanout — money-mule fan-out from one hub card.
-- Params: hub_card (CARD.card_id), start_dt/end_dt (TRANSACTION.dt window).
-- Returns: Out (TRANSACTION evidence IDs), Recipients (EMAIL node IDs).
-- NOTE: GSQL forbids ORDER BY on a vertex set that feeds a further SELECT,
-- so Out is unordered here; callers sort by dt client-side. Callers flag
-- round-amount dispersal (identical integer amounts).
CREATE QUERY q_mule_fanout(STRING hub_card, UINT start_dt, UINT end_dt) FOR GRAPH fraud_graph {
  Seed = {CARD.*};
  Seed = SELECT s FROM Seed:s WHERE s.card_id == hub_card;
  Out = SELECT t FROM Seed:s -(MADE_WITH)- TRANSACTION:t
        WHERE t.dt BETWEEN start_dt AND end_dt;
  Recipients = SELECT e FROM Out:t -(USED_EMAIL)- EMAIL:e;
  PRINT Out, Recipients;
}

-- Q4: q_takeover_anomaly — account-takeover anomaly for a card.
-- Params: card_id (CARD.card_id), window_secs (velocity window over dt).
-- Returns: Txns (TRANSACTION evidence IDs), Devices/Emails/Addrs showing
--   addr/device/email change plus velocity. Covers account_takeover investigations.
CREATE QUERY q_takeover_anomaly(STRING card_id, UINT window_secs) FOR GRAPH fraud_graph {
  Seed = {CARD.*};
  Seed = SELECT s FROM Seed:s WHERE s.card_id == card_id;
  Txns = SELECT t FROM Seed:s -(MADE_WITH)- TRANSACTION:t;
  Devices = SELECT d FROM Txns:t -(USED_DEVICE)- DEVICE:d;
  Emails = SELECT e FROM Txns:t -(USED_EMAIL)- EMAIL:e;
  ShipAddrs = SELECT a FROM Txns:t -(SHIPPED_TO)- ADDRESS:a;
  BillAddrs = SELECT a FROM Txns:t -(BILLED_TO)- ADDRESS:a;
  PRINT Txns, Devices, Emails, ShipAddrs, BillAddrs;
}

-- Q5: q_synthetic_identity — synthetic-identity signals for a card.
-- Params: card_id (CARD.card_id).
-- Returns: Txns (TRANSACTION evidence IDs), Ids (IDENTITY vertices: thin-file
--   C-counts, all-F M-flags, id_ mismatch signals). Supports account_takeover investigations (synthetic-identity style signals).
CREATE QUERY q_synthetic_identity(STRING card_id) FOR GRAPH fraud_graph {
  Seed = {CARD.*};
  Seed = SELECT s FROM Seed:s WHERE s.card_id == card_id;
  Txns = SELECT t FROM Seed:s -(MADE_WITH)- TRANSACTION:t;
  Ids = SELECT i FROM Txns:t -(HAS_IDENTITY)- IDENTITY:i;
  PRINT Txns, Ids;
}

-- Q6: q_evidence_subgraph — bounded 2-hop evidence export around case entities.
-- Params: txn_ids (seed TRANSACTION ids).
-- Returns: AllN (seed TRANSACTION evidence IDs plus node IDs reached within
--   2 traversals). Used by runner to build evidence_ids.
-- NOTE: fixed 2-hop straight-line expansion — the GSQL REST endpoint on this
-- build hangs on WHILE loops, so the parameterized k-hop loop version is not
-- installed. The local engine (client.py evidence_subgraph) keeps the k-hop form.
CREATE QUERY q_evidence_subgraph(SET<UINT> txn_ids) FOR GRAPH fraud_graph {
  Seed = {TRANSACTION.*};
  Seed = SELECT s FROM Seed:s WHERE s.txn_id IN txn_ids;
  H1 = SELECT n FROM Seed:s
       -(MADE_WITH|USED_DEVICE|USED_EMAIL|SHIPPED_TO|BILLED_TO|HAS_IDENTITY|SOLD_BY)- :n;
  H2 = SELECT n FROM H1:s
       -(MADE_WITH|USED_DEVICE|USED_EMAIL|SHIPPED_TO|BILLED_TO|HAS_IDENTITY|SOLD_BY)- :n;
  AllN = Seed UNION H1 UNION H2;
  PRINT AllN;
}

-- Q7: q_get_transactions — full attribute rows for a set of transactions.
-- Params: transaction_ids (seed TRANSACTION ids).
-- Returns: Txns (TRANSACTION vertices with amt, dt, product_cd).
-- NOTE: is_fraud is a benchmark-only label and is deliberately NOT printed:
-- live investigations must not see ground truth. Backs the local
-- get_transactions tool (src/mcp/tools.py) via the MCP bridge.
CREATE QUERY q_get_transactions(SET<UINT> transaction_ids) FOR GRAPH fraud_graph {
  Txns = {TRANSACTION.*};
  Txns = SELECT t FROM Txns:t WHERE t.txn_id IN transaction_ids;
  PRINT Txns;
}

-- Q8: q_ring_components — weakly connected components over the
-- CARD—TRANSACTION—DEVICE subgraph via label propagation. This is a genuine
-- graph algorithm (iterative min-label diffusion over the full edge set),
-- not a bounded traversal: every card linked to another through any chain
-- of shared devices converges to one component label. Components with more
-- than one card are candidate fraud rings for R6/R9 analyst review.
-- Returns: CardComp (card_id -> component label), CompSize (component -> card count).
-- NOTE: 10 propagation rounds are unrolled straight-line — the GSQL REST
-- endpoint on this build hangs on WHILE loops, so the parameterized
-- max_iter loop version is not installed. 10 was the loop default anyway.
CREATE QUERY q_ring_components() FOR GRAPH fraud_graph {
  MinAccum<STRING> @comp;
  MapAccum<STRING, STRING> @@card_comp;
  MapAccum<STRING, INT> @@comp_size;

  Cards = {CARD.*};
  Cards = SELECT c FROM Cards:c ACCUM c.@comp += c.card_id;
  Devs = SELECT d FROM DEVICE:d ACCUM d.@comp += d.device;

  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  P = SELECT c FROM CARD:c
       -(MADE_WITH)- TRANSACTION:m -(USED_DEVICE)- DEVICE:d
       ACCUM c.@comp += d.@comp;
  P = SELECT d FROM DEVICE:d
       -(USED_DEVICE)- TRANSACTION:m -(MADE_WITH)- CARD:c
       ACCUM d.@comp += c.@comp;
  Assign = SELECT c FROM CARD:c
           ACCUM @@card_comp += (c.card_id -> c.@comp);
  Sizes = SELECT c FROM CARD:c ACCUM @@comp_size += (c.@comp -> 1);
  PRINT @@card_comp, @@comp_size;
}
